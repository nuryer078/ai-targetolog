META_ACCESS_TOKEN = "EAA..."
META_AD_ACCOUNT_ID = "..."
META_PAGE_ID = "..."
META_PIXEL_ID = "..."
REPLICATE_API_TOKEN = "r8_..."
TELEGRAM_BOT_TOKEN = "..."
TELEGRAM_CHAT_ID = "..."

# Безопасность
DRY_RUN = "true"
MAX_DAILY_BUDGET = "10"
TARGET_CPL = "5"
