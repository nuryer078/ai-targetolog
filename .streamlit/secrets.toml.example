# Шаблон секретов для Streamlit Community Cloud.
# В облаке: Manage app -> Settings -> Secrets — вставь эти строки со своими значениями.
# Локально этот файл НЕ нужен (используй .env). Реальные значения в git не коммить.

ANTHROPIC_API_KEY = "sk-ant-..."
