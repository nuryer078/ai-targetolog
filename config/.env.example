# ============================================================
#  AI-таргетолог — пример конфигурации.
#  Скопируй в  .env  (в корне проекта) и подставь реальные значения.
#  .env в git НЕ попадает (см. .gitignore). Значения ниже — плейсхолдеры.
# ============================================================

# --- LLM: Claude (Anthropic) ---
# Где взять: https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Модель-движок агентов. Опус — дороже/умнее, Соннет — быстрее/дешевле.
LLM_MODEL=claude-opus-4-8
# Более дешёвая модель для массовой генерации текста (Creative-агент)
LLM_MODEL_CHEAP=claude-sonnet-5

# --- Meta Ads (Facebook Graph API) ---
# App ID / Secret: https://developers.facebook.com/apps -> твоё приложение -> Settings -> Basic
META_APP_ID=000000000000000
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Long-lived access token с правами ads_management, ads_read.
# Взять в Graph API Explorer, затем обменять на долгоживущий (инструкция в README).
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID рекламного кабинета БЕЗ префикса act_ (его добавит код). Пример: 1234567890
META_AD_ACCOUNT_ID=0000000000
# ID Facebook-страницы, от имени которой публикуются объявления
META_PAGE_ID=000000000000000
# Версия Graph API
META_API_VERSION=v21.0

# --- Генерация картинок: Replicate (Flux.1) ---
# Где взять: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Модель генерации (owner/name или полный version-id)
IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# --- Telegram (отчёты и алерты) ---
# BotFather -> /newbot -> получишь токен
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# ID чата/канала, куда слать отчёты (можно узнать через @userinfobot)
TELEGRAM_CHAT_ID=000000000

# ============================================================
#  ПРЕДОХРАНИТЕЛИ — читай внимательно, это про твой бюджет
# ============================================================

# true  = ничего реально не откручивается: всё создаётся в статусе PAUSED (безопасно).
# false = кампании можно активировать. Меняй ТОЛЬКО когда убедился, что всё верно.
DRY_RUN=true

# Жёсткий потолок дневного бюджета одной группы объявлений, в валюте кабинета.
# Media Buyer физически не создаст adset дороже.
MAX_DAILY_BUDGET=10.0

# Порог цены лида (CPL) для Optimizer. Если факт выше — группа ставится на паузу.
TARGET_CPL=5.0

# Валюта кабинета (для читаемых отчётов). Meta считает в минимальных единицах.
CURRENCY=USD
